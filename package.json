{
  "name": "housemd",
  "version": "2.0.0",
  "private": true,
  "description": "A quiet, local-first Markdown editor built with Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "author": "Arnav Padwal",
  "homepage": "https://github.com/arnavpadwal/HouseMD#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnavpadwal/HouseMD.git"
  },
  "bugs": {
    "url": "https://github.com/arnavpadwal/HouseMD/issues"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=10"
  },
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "desktop",
    "typescript",
    "mermaid",
    "katex"
  ]
}
