{
  "$schema": "https://schema.tauri.app/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for HouseMD",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:scope-home-recursive",
    "opener:default"
  ]
}
